# ── Newsletter (Resend) ───────────────────────────────────────────────────────
# Copy this file to `.env.local` for local dev, and set the same variables in
# your Vercel project settings for production. Never commit real values.

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The Resend Audience that stores your subscribers.
# Create an audience at https://resend.com/audiences and copy its ID.
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# The verified "from" address for sends. The domain must be verified in Resend
# (https://resend.com/domains) with the DNS records it gives you.
NEWSLETTER_FROM="Crust & Bloom <hello@crustandbloom.com>"

# Passphrase that protects the /admin/newsletter compose page and the send API.
# Use a long random string. Anyone with this can email your whole list.
ADMIN_SECRET=change-me-to-a-long-random-string

# Optional: default address used by "Send test to me" when the field is left
# blank on the compose page.
ADMIN_EMAIL=you@example.com
